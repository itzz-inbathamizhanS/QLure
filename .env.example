# Every value here is FAKE. Copy to .env for local runs; never put real secrets in this repo.
QLURE_LOG_DIR=logs
# Dashboard session signing key (fake placeholder; generate your own: openssl rand -hex 32)
QLURE_DASHBOARD_SECRET=change-me-fake-placeholder
# Local (non-Docker) runs of the SSH and banner decoys: bind to loopback only (default 0.0.0.0)
QLURE_BIND_HOST=127.0.0.1
# Operator-side webhook alerts (off unless set; a secret URL, never commit a real one)
# QLURE_ALERT_WEBHOOK=https://hooks.example.invalid/services/FAKE/PLACEHOLDER
# QLURE_ALERT_ALLOW_PRIVATE=0
